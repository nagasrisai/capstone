# ---- Claude ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium            # low | medium | high | xhigh | max

# ---- You (the owner) ------------------------------------------------------
OWNER_NAME=Sai
OWNER_PHONE=+919876543210        # E.164; the only number the assistant will talk to
# OWNER_WHATSAPP=whatsapp:+919876543210   # defaults to whatsapp:OWNER_PHONE
OWNER_TIMEZONE=Asia/Kolkata

# ---- Twilio ---------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # WhatsApp sandbox number, or your approved sender
TWILIO_VOICE_FROM=+15017122661               # a Twilio voice-capable number you own
VALIDATE_TWILIO_SIGNATURE=true
VOICE_LANGUAGE=en-US
VOICE_NAME=Polly.Joanna

# ---- Server ---------------------------------------------------------------
PUBLIC_BASE_URL=https://your-domain-or-ngrok-url   # must be reachable by Twilio
DATABASE_PATH=data/assistant.db
REMINDER_POLL_SECONDS=15
VOICE_POLL_TIMEOUT_SECONDS=75

# ---- Behaviour ------------------------------------------------------------
DEFAULT_CLARIFICATION_CHANNEL=whatsapp   # whatsapp | call
MAX_CONVERSATION_MESSAGES=80
CONVERSATION_IDLE_HOURS=12
